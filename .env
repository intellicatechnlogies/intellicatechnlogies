# Local development defaults only. Replace the placeholder secret before any deployment.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-for-local-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# SQLite is for local development only. Use PostgreSQL/Cloud SQL in production.
DB_ENGINE=sqlite3
