# Local development defaults. Do not deploy these values.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-for-local-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# SQLite is used in production. Set DB_NAME to an absolute persistent path on the server.
DB_ENGINE=sqlite3
# DB_NAME=/var/lib/intellica/db.sqlite3
DB_SQLITE_TIMEOUT=30
